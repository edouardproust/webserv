server {
	listen localhost:8081;

    error_page 404 /errors/404.html;

    # -----------------------
    # BASIC ROUTES
    # -----------------------

    location / {
		root ./tests/website; # <- comment this line to get webserv default index
          cgi .py /usr/bin/python3;
		cgi .php /usr/bin/php-cgi;
        limit_except GET;
    }


    location /dir-index/ {
		root ./tests/website;
		index hello.html; # <- comment this line to get index.htm
        autoindex on;
    }

	location /dir-listing/ {
		root ./tests/website;
		index invalid-index.html;
        autoindex on;
    }

	location /dir-off/ {
		root ./tests/website;
        autoindex off;
    }

    # -----------------------
    # UPLOAD AND DELETE TESTS
    # -----------------------
    location /uploads {
		root ./tests/website;
        limit_except POST DELETE;
        client_max_body_size 1M; # limit for body size test
    }

    # -----------------------
    # CGI TESTS
    # -----------------------
    location /cgi/ {
		root ./tests/website;
        cgi .py /usr/bin/python3;
		cgi .php /usr/bin/php-cgi;
        limit_except GET POST;
    }

    # -----------------------
    # REDIRECTION AND CUSTOM ERRORS
    # -----------------------
    location /redirect {
        return 301 http://localhost:8080/;
    }

    location /errors/ {
		root ./tests/website;
        limit_except GET;
    }

    # -----------------------
    # SECURITY
    # -----------------------
    location /forbidden {
        return 403;
    }
}
