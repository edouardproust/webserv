server {
    listen 8080;
	listen localhost:443 1.1.1.1:80;

	root /home/edouard/Projects/webserv/tests/website;

    error_page 404 ./website/errors/404.html;

    # -----------------------
    # BASIC ROUTES
    # -----------------------

    location / {
        limit_except GET;
    }


    location /dir-index/ {
		index ../home.html ../home.htm; # <- comment this line to get index.htm
        autoindex on;
    }

	location /dir-listing/ {
		index invalid-index.html;
        autoindex on;
    }

	location /dir-off/ {
        autoindex off;
    }

    # -----------------------
    # UPLOAD AND DELETE TESTS
    # -----------------------
    location /uploads {
        limit_except POST DELETE;
        client_max_body_size 1M; # limit for body size test
    }

    # -----------------------
    # CGI TESTS
    # -----------------------
    location /cgi/ {
        cgi .py /usr/bin/python3;
		cgi .php /usr/bin/php-cgi;
        limit_except GET POST;
    }

    # -----------------------
    # REDIRECTION AND CUSTOM ERRORS
    # -----------------------
    location /redirect {
        return 301 http://localhost:8080/;
    }

    location /errors/ {
        limit_except GET;
    }

    # -----------------------
    # SECURITY
    # -----------------------
    location /forbidden {
        return 403;
    }
}
