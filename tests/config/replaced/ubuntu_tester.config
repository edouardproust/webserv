server {
	listen 8080;
	root /home/edouard/Projects/webserv/tests/website;

	location / {
		allowed_methods GET;
	}

	location /post_body {
		allowed_methods POST;
		client_max_body_size 100;
	}

	location /directory {
		allowed_methods GET POST;
		index youpi.bad_extension;
		autoindex off;
		cgi .bla /home/edouard/Projects/webserv/tests/ubuntu_cgi_tester;
	}

	location /cgi {
    	allowed_methods GET POST;
    	cgi .cgi /home/edouard/Projects/webserv/tests/website/cgi/test.cgi;
	}

}