server {
    listen 0.0.0.0:80 localhost:457;
    listen localhost:8080;
    root /home/fpapadak/webserv/test_files/var/www/html;

    location / {
        root /home/fpapadak/webserv/test_files/var/www/html;
    }

    location /images {
        root /home/fpapadak/webserv/test_files/var/www/images;
        limit_except GET POST DELETE;
        error_page 400 /400.html;
    }

    location /ima {
        root /home/fpapadak/webserv/test_files/var/www/html;
    }

    location /images/icons/ {
        root /home/fpapadak/webserv/test_files/var/www/images/icons;
    }

    location /images/test.jpg {
        root /home/fpapadak/webserv/test_files/var/www/images;
    }

    location /cgi-bin/ {
        root /home/fpapadak/webserv/test_files/var/www/html;
        cgi .php /usr/bin/php-cgi;
        cgi .py /usr/bin/python3;
    }
}