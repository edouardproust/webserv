# =========================
# Webserv Test Configuration (42)
# =========================

server {
    listen 8080;

    root /var/www/html/website;
    index index.html;

    # ----------------------
    # Default route
    # ----------------------
    location / {
        autoindex on;
        limit_except GET POST DELETE;
        index index.html;
    }

    # ----------------------
    # Upload route
    # ----------------------
    location /upload/ {
        root /var/www/html/website;
        limit_except GET POST DELETE;
        client_max_body_size 1M;  # Test du 413
        autoindex on;
    }

    # ----------------------
    # CGI configuration
    # ----------------------
    location /cgi-bin/ {
        root /var/www/html/website;
        limit_except GET POST;
        autoindex on;
        cgi .php /usr/bin/php-cgi;
        cgi .py  /usr/bin/python3;
    }

    # ----------------------
    # Redirection test
    # ----------------------
    location /redirect {
        return 301 http://localhost:8080/;
    }

    # ----------------------
    # Custom 404 test
    # ----------------------
    location /error404 {
        return 404;
    }

    # ----------------------
    # Error pages
    # ----------------------
    error_page 404 /errors/404.html;
    error_page 405 /errors/405.html;
    error_page 413 /errors/413.html;
    error_page 500 /errors/500.html;
    error_page 504 /errors/504.html;

    # ----------------------
    # Security test: forbid /secret
    # ----------------------
    location /secret {
        return 403;
    }
}
